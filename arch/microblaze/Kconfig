menu "MicroBlaze architecture"
	depends on MICROBLAZE

config SYS_ARCH
	default "microblaze"

config STATIC_RELA
	def_bool y

choice
	prompt "Target select"
	optional

config TARGET_MICROBLAZE_GENERIC
	bool "Support microblaze-generic"
	select BOARD_LATE_INIT
	select DM
	select DM_SERIAL
	select OF_CONTROL
	select SUPPORT_SPL
	select SPL_LIBCOMMON_SUPPORT if SPL
	select SPL_LIBGENERIC_SUPPORT if SPL
	select SYSRESET
	select DM_SPI
	select DM_SPI_FLASH
	select MTD
	select SPI
	imply CMD_DM

config TARGET_MICROBLAZE_THUNDERHILL
	bool "Support microblaze-thunderhill"
	select DM
	select MMC
	select CLK
	select TIMER
	select DM_SERIAL
	select OF_CONTROL
	select SUPPORT_SPL
	select SPL_LIBCOMMON_SUPPORT if SPL
	select SPL_LIBGENERIC_SUPPORT if SPL
	select SPL_MMC
	select SPL_DM
	select SPL_SERIAL
	select SPL_CLK
	select SPL_TIMER

endchoice

source "board/xilinx/Kconfig"
source "board/xilinx/microblaze-generic/Kconfig"
source "board/xilinx/microblaze-thunderhill/Kconfig"

endmenu
